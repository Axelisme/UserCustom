"""Canonical Contract coverage for rejecting residual provisional probe paths."""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from tests._orchestrate_cli_support import OrchestrateCliRepositoryTestCase, run_git


class ProbeCollectionContractTests(OrchestrateCliRepositoryTestCase):
    """Exercise residual-probe refusal through the shipped CLI."""

    task_id = "probe-collection-contract"
    lane_id = "writer"
    probe_path = "tests/_probe/T001/test_orchestrate_probe_collection.py"

    def task_root(self) -> Path:
        return self.root / ".agent_state" / "worktrees" / self.task_id

    def lane_path(self) -> Path:
        return self.task_root() / "lanes" / self.lane_id

    def integration_path(self) -> Path:
        return self.task_root() / "integration"

    def create_task(self) -> None:
        self.mutation_success(
            self.cli(
                self.nested,
                "integration",
                "create",
                "--task-id",
                self.task_id,
            ),
            "integration-create",
        )

    def create_lane(self) -> None:
        self.mutation_success(
            self.cli(
                self.nested,
                "lane",
                "create",
                "--task-id",
                self.task_id,
                "--lane-id",
                self.lane_id,
            ),
            "lane-create",
        )

    def commit_files(
        self,
        cwd: Path,
        files: dict[str, str],
        subject: str,
    ) -> None:
        for path, content in files.items():
            target = cwd / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content, encoding="utf-8")
        run_git(cwd, "add", "--", *files)
        run_git(cwd, "commit", "-q", "-m", subject)

    def delete_file(self, cwd: Path, path: str, subject: str) -> None:
        (cwd / path).unlink()
        run_git(cwd, "add", "--", path)
        run_git(cwd, "commit", "-q", "-m", subject)

    def freeze_probe_contract(self) -> None:
        target = self.lane_path() / self.probe_path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text("red probe\n", encoding="utf-8")
        run_git(self.lane_path(), "add", self.probe_path)
        message_file = self.root / "probe-contract.message"
        message_file.write_text("Freeze residual probe Contract\n", encoding="utf-8")
        result = self.cli(
            self.lane_path(),
            "lane",
            "commit",
            "--task-id",
            self.task_id,
            "--lane-id",
            self.lane_id,
            "--message-file",
            str(message_file),
            "--contract",
        )
        payload = self.success(result)
        self.assertEqual(payload["operation"], "lane-commit")
        self.assertEqual(self.git(self.lane_path(), "status", "--porcelain"), "")

    def collect(self, ticket: str) -> Any:
        return self.cli(
            self.nested,
            "integration",
            "collect",
            "--task-id",
            self.task_id,
            "--lane-id",
            self.lane_id,
            "--ticket",
            ticket,
        )

    def assert_collects(self, ticket: str) -> dict[str, Any]:
        return self.mutation_success(self.collect(ticket), "integration-collect")

    def assert_probe_refusal(
        self,
        result: Any,
        expected_paths: list[str],
    ) -> dict[str, Any]:
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertEqual(result.stderr, "")
        payload: dict[str, Any] = json.loads(result.stdout)
        self.assertIs(payload["ok"], False)
        self.assertEqual(payload["operation"], "integration-collect")
        self.assertEqual(payload["orchestrate_version"], self.orchestrate_version)
        self.assertEqual(payload["code"], "unresolved_probe_paths")
        self.assertEqual(payload["details"], {"paths": expected_paths})
        repair = payload["repair"]
        self.assertIsInstance(repair, str)
        self.assertIn("promote", repair.lower())
        self.assertIn("delete", repair.lower())
        return payload

    def test_residual_added_probe_is_rejected_before_collection(self) -> None:
        self.create_task()
        self.create_lane()
        self.freeze_probe_contract()

        integration = self.integration_path()
        lane_tip = self.git(self.lane_path(), "rev-parse", "HEAD")
        integration_tip = self.git(integration, "rev-parse", "HEAD")
        result = self.collect("residual-added-probe")

        self.assert_probe_refusal(result, [self.probe_path])
        self.assertEqual(self.git(integration, "rev-parse", "HEAD"), integration_tip)
        self.assertEqual(self.git(integration, "status", "--porcelain"), "")
        self.assertEqual(self.git(self.lane_path(), "rev-parse", "HEAD"), lane_tip)
        self.assertEqual(self.git(self.lane_path(), "status", "--porcelain"), "")

    def test_preexisting_probe_modified_in_lane_is_collectable(self) -> None:
        self.create_task()
        self.commit_files(
            self.integration_path(),
            {self.probe_path: "already canonicalized\n"},
            "Seed an existing probe path",
        )
        self.create_lane()
        self.commit_files(
            self.lane_path(),
            {self.probe_path: "modify existing probe\n"},
            "Modify an existing probe path",
        )

        self.assert_collects("modified-existing-probe")

    def test_probe_added_then_deleted_from_final_tree_is_collectable(self) -> None:
        self.create_task()
        self.create_lane()
        self.commit_files(
            self.lane_path(),
            {self.probe_path: "temporary probe\n"},
            "Add a temporary probe",
        )
        self.delete_file(
            self.lane_path(), self.probe_path, "Delete the temporary probe"
        )

        self.assert_collects("deleted-probe")

    def test_probe_promoted_out_of_final_tree_is_collectable(self) -> None:
        promoted = "tests/test_orchestrate_probe_collection_promoted.py"
        self.create_task()
        self.create_lane()
        self.commit_files(
            self.lane_path(),
            {self.probe_path: "promote this probe\n"},
            "Add a probe to promote",
        )
        run_git(self.lane_path(), "mv", self.probe_path, promoted)
        run_git(self.lane_path(), "commit", "-q", "-m", "Promote the probe")

        self.assert_collects("promoted-probe")

    def test_exact_probe_component_is_case_sensitive_and_space_safe(self) -> None:
        paths = {
            "tests/_Probe/case-mismatch.py": "case mismatch\n",
            "tests/_probeish/nested.py": "component suffix\n",
            "nested root/_probe cases/space file.py": "space component\n",
            "tests/probe/_probeish.py": "filename suffix\n",
        }
        self.create_task()
        self.create_lane()
        self.commit_files(self.lane_path(), paths, "Add compatible probe-like paths")

        self.assert_collects("compatible-probe-like-paths")

    def test_multiple_residual_paths_are_sorted_and_space_safe(self) -> None:
        paths = [
            "nested root/_probe/space file.py",
            "tests/_probe/T001/another.py",
        ]
        self.create_task()
        self.create_lane()
        self.commit_files(
            self.lane_path(),
            {path: "residual\n" for path in paths},
            "Add multiple residual probes",
        )
        integration_tip = self.git(self.integration_path(), "rev-parse", "HEAD")

        self.assert_probe_refusal(self.collect("multiple-residual-probes"), paths)
        self.assertEqual(
            self.git(self.integration_path(), "rev-parse", "HEAD"), integration_tip
        )

    def test_renaming_existing_probe_away_is_collectable(self) -> None:
        promoted = "tests/test_orchestrate_probe_collection_renamed.py"
        self.create_task()
        self.commit_files(
            self.integration_path(),
            {self.probe_path: "rename this existing probe\n"},
            "Seed a probe to rename",
        )
        self.create_lane()
        run_git(self.lane_path(), "mv", self.probe_path, promoted)
        run_git(self.lane_path(), "commit", "-q", "-m", "Rename probe to canonical path")

        self.assert_collects("renamed-probe")

    def test_renaming_into_probe_is_a_new_residual_path(self) -> None:
        source = "tests/test_orchestrate_probe_collection_source.py"
        target = "tests/_probe/T001/renamed.py"
        self.create_task()
        self.create_lane()
        self.commit_files(
            self.lane_path(),
            {source: "rename into probe\n"},
            "Seed a canonical path",
        )
        (self.lane_path() / target).parent.mkdir(parents=True, exist_ok=True)
        run_git(self.lane_path(), "mv", source, target)
        run_git(self.lane_path(), "commit", "-q", "-m", "Rename into probe")

        self.assert_probe_refusal(self.collect("renamed-into-probe"), [target])

    def test_persistent_lane_uses_current_integration_tree_for_final_diff(self) -> None:
        persistent_probe = "tests/_probe/T001/persistent.py"
        self.create_task()
        self.create_lane()
        self.commit_files(
            self.lane_path(),
            {"feature.txt": "first collected feature\n"},
            "Collect a first feature",
        )
        self.assert_collects("persistent-first-feature")

        self.commit_files(
            self.lane_path(),
            {persistent_probe: "persistent residual\n"},
            "Add a residual probe after collection",
        )
        integration_tip = self.git(self.integration_path(), "rev-parse", "HEAD")
        lane_tip = self.git(self.lane_path(), "rev-parse", "HEAD")

        self.assert_probe_refusal(self.collect("persistent-residual-probe"), [persistent_probe])
        self.assertEqual(
            self.git(self.integration_path(), "rev-parse", "HEAD"), integration_tip
        )
        self.assertEqual(self.git(self.lane_path(), "rev-parse", "HEAD"), lane_tip)


if __name__ == "__main__":
    import unittest

    unittest.main()
